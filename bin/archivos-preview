#!/usr/bin/env bash
# Describe how to preview a file. First line of output is the kind:
#   image PATH   an image to show (the file itself, or a cached thumbnail)
#   text         followed by the start of the file
#   none
#
#   archivos-preview PATH [BYTES]
set -u

path=${1:?uso: archivos-preview PATH [BYTES]}
bytes=${2:-4000}

[ -f "$path" ] || { echo none; exit 0; }

mime=$(file --brief --mime-type --dereference -- "$path" 2>/dev/null)
cache=${XDG_CACHE_HOME:-$HOME/.cache}/archivos/thumbs
thumb=$cache/$(printf '%s:%s' "$(readlink -f -- "$path")" "$(stat -c %Y -- "$path")" | sha1sum | cut -c1-40).png

case $mime in
    image/*)
        echo "image $path"
        ;;
    video/*)
        mkdir -p "$cache"
        [ -s "$thumb" ] || ffmpegthumbnailer -i "$path" -o "$thumb" -s 720 -t 15% >/dev/null 2>&1
        if [ -s "$thumb" ]; then echo "image $thumb"; else echo none; fi
        ;;
    application/pdf)
        mkdir -p "$cache"
        [ -s "$thumb" ] || pdftoppm -png -singlefile -scale-to 900 -f 1 -l 1 -- "$path" "${thumb%.png}" >/dev/null 2>&1
        if [ -s "$thumb" ]; then echo "image $thumb"; else echo none; fi
        ;;
    text/* | application/json | application/toml | application/x-shellscript | application/xml | application/javascript)
        echo text
        head -c "$bytes" -- "$path" | iconv -f utf-8 -t utf-8 -c
        ;;
    *)
        echo none
        ;;
esac
