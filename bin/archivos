#!/usr/bin/env bash
# The file manager from the terminal: open it, drive the open window, or run a
# file operation without it.
set -eu

root=$(dirname "$(dirname "$(readlink -f "$0")")")

usage() {
    cat <<'TEXT'
archivos [RUTA]                 abre el gestor; si ya está abierto, lo lleva a RUTA
archivos ir RUTA                lleva la ventana abierta a RUTA
archivos filtro [TEXTO]         filtra la carpeta que se está viendo
archivos buscar TEXTO           busca por nombre en la carpeta y sus subcarpetas
archivos dentro TEXTO           busca archivos de texto que contengan TEXTO
archivos estado                 lo que muestra la ventana, en JSON
archivos vista                  cambia entre lista y cuadrícula
archivos comandos               abre la paleta de comandos

archivos dispositivos           equipos de Tailscale a los que se puede enviar
archivos enviar EQUIPO ARCHIVO...   manda archivos por Tailscale

archivos copiar DESTINO ORIGEN...   copia sin sobrescribir
archivos mover DESTINO ORIGEN...    mueve sin sobrescribir
archivos renombrar ORIGEN NOMBRE
archivos carpeta DONDE NOMBRE       crea una carpeta
archivos papelera ORIGEN...         manda a la papelera
archivos comprimir FORMATO ORIGEN...   zip, tar.gz, tar.xz o 7z
archivos extraer ARCHIVO            extrae en una carpeta nueva
archivos info RUTA                  lo que se sabe de un archivo o carpeta

archivos compilar               compila el motor (hace falta la primera vez)
archivos pruebas                corre las pruebas del motor y las de la ventana
TEXT
}

motor=$root/motor/target/release/archivos-motor

engine() {
    [ -x "$motor" ] || { echo "Falta compilar el motor: archivos compilar" >&2; exit 1; }
    exec "$motor" "$@"
}

window() {
    qs -p "$root" ipc call archivos "$@"
}

running() {
    window state >/dev/null 2>&1
}

# Bring the open window to the front, where the compositor lets us.
raise() {
    command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 || return 0
    local pid address
    pid=$(pgrep -f "^qs -p $root\$" | head -1)
    [ -n "$pid" ] || return 0
    address=$(hyprctl clients -j 2>/dev/null | jq -r --argjson pid "$pid" '.[] | select(.pid == $pid) | .address' | head -1)
    [ -n "$address" ] && hyprctl eval "hl.dispatch(hl.dsp.focus({ window = \"address:$address\" }))" >/dev/null 2>&1
    return 0
}

need_window() {
    running || { echo "El gestor no está abierto." >&2; exit 1; }
}

open_at() {
    local dir=${1:-}
    if [ -n "$dir" ]; then
        dir=$(readlink -f -- "$dir")
        [ -d "$dir" ] || dir=$(dirname -- "$dir")
    fi
    if running; then
        [ -n "$dir" ] && window go "$dir"
        raise
        return 0
    fi
    [ -x "$motor" ] || { echo "Falta compilar el motor: archivos compilar" >&2; exit 1; }
    [ -n "$dir" ] && export ARCHIVOS_DIR=$dir
    exec qs -p "$root"
}

case ${1:-} in
    "") open_at ;;
    ayuda | -h | --help) usage ;;
    ir) need_window; window go "$(readlink -f -- "${2:?falta la ruta}")" ;;
    filtro) need_window; window filter "${2:-}" ;;
    buscar) need_window; window search "${2:?falta el texto}" ;;
    dentro) need_window; window inside "${2:?falta el texto}" ;;
    estado) need_window; window state ;;
    vista) need_window; window grid ;;
    comandos) need_window; window palette ;;
    dispositivos) tailscale file cp --targets ;;
    enviar)
        [ $# -ge 3 ] || { echo "uso: archivos enviar EQUIPO ARCHIVO..." >&2; exit 2; }
        target=$2
        shift 2
        exec tailscale file cp -- "$@" "$target:"
        ;;
    copiar) shift; engine copy "$@" ;;
    mover) shift; engine move "$@" ;;
    renombrar) shift; engine rename "$@" ;;
    carpeta) shift; engine mkdir "$@" ;;
    papelera) shift; engine trash "$@" ;;
    comprimir) shift; engine compress "$@" ;;
    extraer) shift; engine extract "$@" ;;
    info) shift; engine info "$@" ;;
    compilar) exec cargo build --release --manifest-path "$root/motor/Cargo.toml" ;;
    pruebas) cargo test --manifest-path "$root/motor/Cargo.toml" && exec "$root/tests/input.sh" ;;
    *) open_at "$1" ;;
esac
