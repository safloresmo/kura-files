#!/usr/bin/env bash
# Set Kura Files up for this user: build the engine, put the command on the
# path and add the launcher. Nothing is written outside the home folder.
#   ./instalar                             lo básico · the basics
#   ./instalar --servicios | --services    «mostrar en carpeta» y selector de archivos · show in folder and file chooser
#   ./instalar --por-defecto | --default   gestor de archivos por defecto · default file manager
#   ./instalar --quitar | --remove         deshace lo anterior · undo all of it
set -euo pipefail

root=$(dirname "$(readlink -f "$0")")

# Spanish where the system speaks it, English elsewhere.
say() {
    case ${LC_ALL:-${LC_MESSAGES:-${LANG:-es}}} in
        es*) printf '%s\n' "$1" ;;
        *) printf '%s\n' "$2" ;;
    esac
}
bin=${XDG_BIN_HOME:-$HOME/.local/bin}
data=${XDG_DATA_HOME:-$HOME/.local/share}
launcher=$data/applications/archivos.desktop
icon=$data/icons/hicolor/scalable/apps/kura-files.svg
services=$data/dbus-1/services
portal=$data/xdg-desktop-portal/portals/kura.portal

with_services=0 as_default=0 remove=0
for arg in "$@"; do
    case $arg in
        --servicios | --services) with_services=1 ;;
        --por-defecto | --default) as_default=1 ;;
        --quitar | --remove) remove=1 ;;
        -h | --help | ayuda) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) say "No conozco la opción $arg" "Unknown option $arg" >&2; exit 2 ;;
    esac
done

if [ "$remove" = 1 ]; then
    for name in archivos kura; do
        [ "$(readlink -f "$bin/$name" 2>/dev/null)" = "$root/bin/archivos" ] && rm -f "$bin/$name"
    done
    rm -f "$icon"
    # Only what points at this copy goes: another file manager may have put
    # a file of the same name there.
    for file in "$launcher" "$services/org.freedesktop.FileManager1.service" \
        "$services/org.freedesktop.impl.portal.desktop.kura.service"; do
        grep -qF "$root/bin/" "$file" 2>/dev/null && rm -f "$file"
    done
    rm -f "$portal"
    # Folders go back to whatever opened them before, if this was set as the default.
    if command -v xdg-mime >/dev/null 2>&1 && [ "$(xdg-mime query default inode/directory 2>/dev/null)" = archivos.desktop ]; then
        for list in "${XDG_CONFIG_HOME:-$HOME/.config}/mimeapps.list" "$data/applications/mimeapps.list"; do
            [ -f "$list" ] && sed -i '/^inode\/directory=archivos\.desktop;\{0,1\}$/d' "$list"
        done
    fi
    say "Quitado. Tus ajustes siguen en ${XDG_CONFIG_HOME:-$HOME/.config}/archivos." "Removed. Your settings are still in ${XDG_CONFIG_HOME:-$HOME/.config}/archivos."
    exit 0
fi

missing=0
need() {
    command -v "$1" >/dev/null 2>&1 && return 0
    say "Falta $1: $2" "Missing $1: $3" >&2
    missing=1
}
need qs "Quickshell, que dibuja la ventana" "Quickshell, which draws the window"
[ -x "$root/motor/target/release/archivos-motor" ] || need cargo "Rust, para compilar el motor" "Rust, to build the engine"
need gio "GLib y GVFS: papelera, discos, red y «abrir con»" "GLib and GVFS: trash, disks, network and open with"
need bsdtar "libarchive, para comprimir y extraer" "libarchive, to compress and extract"
need jq "para hablar con la ventana abierta" "to talk to the open window"
need wl-copy "wl-clipboard, para copiar y pegar" "wl-clipboard, to copy and paste"
[ "$missing" = 0 ] || { say "Instala lo que falta y vuelve a intentarlo." "Install what is missing and try again." >&2; exit 1; }
# What is not needed to run, with what each one adds. Nothing is installed
# from here: the list is for the person to decide.
optional() {
    command -v "$1" >/dev/null 2>&1 && return 0
    lacking="$lacking $4"
    say "Opcional, no está · $1: $2" "Optional, not found · $1: $3"
}
lacking=
optional pdftoppm "vista previa de PDF" "PDF previews" poppler
optional ffmpegthumbnailer "miniaturas de vídeo" "video thumbnails" ffmpegthumbnailer
optional f3d "miniaturas de modelos 3D" "thumbnails of 3D models" f3d
optional plocate "búsqueda en toda la carpeta personal" "search across the home folder" plocate
optional rclone "cuentas en la nube" "cloud accounts" rclone
optional fusermount3 "montar la nube como carpeta" "mounting the cloud as a folder" fuse3
optional git "repositorios y paquetes de acciones" "repositories and packs of actions" git
optional python3 "«mostrar en carpeta» y selector de archivos" "show in folder and the file chooser" python
optional tailscale "enviar por Tailscale" "sending over Tailscale" tailscale
optional localsend "enviar por LocalSend" "sending with LocalSend" localsend
if [ -n "$lacking" ]; then
    say "Para añadirlos, con el gestor de paquetes de tu sistema:$lacking" "To add them, with your system's package manager:$lacking"
    say "(los nombres son los de Arch; en otras distribuciones pueden cambiar)" "(these are the Arch names; they may differ elsewhere)"
fi

# A download that brings the engine already built needs no compiler.
if command -v cargo >/dev/null 2>&1 && [ -d "$root/motor/src" ]; then
    say "Compilando el motor…" "Building the engine…"
    cargo build --release --quiet --manifest-path "$root/motor/Cargo.toml"
fi

mkdir -p "$bin" "$(dirname "$launcher")"
ln -sfn "$root/bin/archivos" "$bin/archivos"
ln -sfn "$root/bin/archivos" "$bin/kura"
mkdir -p "$(dirname "$icon")"
cp "$root/icono/kura-files.svg" "$icon"
cat >"$launcher" <<DESKTOP
[Desktop Entry]
Type=Application
Name=Kura Files
GenericName=File Manager
GenericName[es]=Gestor de archivos
Comment=Browse and organise your files
Comment[es]=Explora y ordena tus archivos
Exec="$root/bin/archivos" %f
Icon=kura-files
Terminal=false
Categories=System;FileTools;FileManager;
MimeType=inode/directory;
Keywords=files;file;folder;folders;explorer;manager;browser;archivos;archivo;carpetas;carpeta;ficheros;explorador;gestor;kura;
Keywords[es]=archivos;archivo;carpetas;carpeta;ficheros;explorador;gestor;files;file;kura;
StartupWMClass=org.quickshell
DESKTOP
command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$(dirname "$launcher")" 2>/dev/null || true

if [ "$with_services" = 1 ]; then
    if python3 -c 'import gi' 2>/dev/null; then
        mkdir -p "$services" "$(dirname "$portal")"
        mine=$services/org.freedesktop.FileManager1.service
        if [ -f "$mine" ] && ! grep -qF "$root/bin/" "$mine"; then
            say "Otro programa atiende ya «mostrar en carpeta» ($mine); lo dejo como está." "Another program already answers show in folder ($mine); left as it is."
        else
            printf '[D-BUS Service]\nName=org.freedesktop.FileManager1\nExec="%s/bin/archivos-servicio"\n' "$root" >"$mine"
        fi
        printf '[D-BUS Service]\nName=org.freedesktop.impl.portal.desktop.kura\nExec="%s/bin/archivos-portal"\n' "$root" \
            >"$services/org.freedesktop.impl.portal.desktop.kura.service"
        printf '[portal]\nDBusName=org.freedesktop.impl.portal.desktop.kura\nInterfaces=org.freedesktop.impl.portal.FileChooser;\n' >"$portal"
        say "Servicios puestos. Para que los programas usen su selector de archivos, añade" "Services in place. For programs to use its file chooser, add"
        echo "  org.freedesktop.impl.portal.FileChooser=kura"
        say "bajo [preferred] en ${XDG_CONFIG_HOME:-$HOME/.config}/xdg-desktop-portal/portals.conf" "under [preferred] in ${XDG_CONFIG_HOME:-$HOME/.config}/xdg-desktop-portal/portals.conf"
        say "y reinicia el servicio: systemctl --user restart xdg-desktop-portal" "and restart the service: systemctl --user restart xdg-desktop-portal"
    else
        say "Los servicios necesitan Python con PyGObject; no se han puesto." "The services need Python with PyGObject; they were not set up." >&2
    fi
fi

if [ "$as_default" = 1 ]; then
    xdg-mime default archivos.desktop inode/directory
    say "Kura Files abre ahora las carpetas." "Kura Files now opens folders."
fi

case ":$PATH:" in
    *":$bin:"*) ;;
    *) say "Ojo: $bin no está en tu PATH; añádelo para poder escribir «archivos»." "Note: $bin is not in your PATH; add it to be able to type «kura»." ;;
esac
say "Listo. Ábrelo con: archivos" "Done. Open it with: kura"
